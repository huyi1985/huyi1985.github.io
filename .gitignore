# Sensitive: never commit
config.d/
# 例外：blacklist.yaml 是构建依赖（build_md_d.py 读取），随代码库提交
!config.d/blacklist.yaml

# Source-of-truth originals (external, ~534M): not in repo
tmp/

# Build output (regenerable with `hugo`)
public/
.hugo_build.lock

# Intermediate pipeline output (md.d/ is the authoritative content; raw is regenerable)
raw_md.d/

# Legacy backup: keep small images + md, skip the huge vintage manpage PNGs (~12MB)

# 2026-09-01 page-bundle 迁移的旧扁平结构备份（一次性，验证后删除）
md.d.flat-legacy-*/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Claude Code session / project docs (keep out of repo)
.claude/
claudedocs/
